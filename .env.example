# Không commit .env chứa API key thật.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=BAAI/bge-m3
SEMANTIC_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# float32 chạy CPU nhanh hơn trên máy hiện tại; bfloat16 dành cho máy thiếu RAM.
MODEL_DTYPE=float32

# OpenRouter dùng openai/text-embedding-3-small; OpenAI dùng text-embedding-3-small.
# EVAL_EMBEDDING_MODEL=openai/text-embedding-3-small
